# Use separate Stellar services. Never put wallet recovery phrases here.
# Stellar payment configuration is validated but not enabled until integration is verified.
STELLAR_NETWORK=stellar:pubnet
STELLAR_PAY_TO=
STELLAR_FACILITATOR_URL=
# The correct USDC asset is selected for the configured network by the Stellar SDK.
# Local workspace database. Model payment state uses DATABASE_URL below.
MANAGER_DB_PATH=
MANAGER_ADMIN_PASSWORD=

# Live model catalogs are public; generation uses this server-only funded API key.
OPENROUTER_API_KEY=
# At least 32 random characters. Retain securely: changing it makes old result data unreadable.
MODEL_DATA_KEY=
# Private Postgres connection string. Never put this in Expo/public env.
DATABASE_URL=
# Enable only after Postgres and the real purchase/failure paths are verified.
MODEL_ENABLE_PAYMENTS=false
# Optional alternative for deployments already using a dedicated persistent SQLite disk.
# Not needed when DATABASE_URL is configured.
MODEL_STORAGE_MOUNT=
