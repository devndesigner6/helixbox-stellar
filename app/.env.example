# Helix Box App Environment Variables
# Copy to .env or set in EAS Build environment settings

# Configure separate Stellar services after they have been deployed.
# EXPO_PUBLIC_GATEWAY_URL=wss://your-stellar-proxy.example
# EXPO_PUBLIC_MANAGER_URL=https://your-stellar-manager.example
# Leave unset to disable OTA updates.
# EXPO_PUBLIC_UPDATE_SERVER_URL=https://your-stellar-update-server.example/hot-updater
